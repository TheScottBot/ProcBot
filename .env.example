# Copy to .env (or .env.dev for a separate test bot, run with: python bot.py --dev).
DISCORD_TOKEN=your-bot-token-here
# Optional: comma-separated server IDs to register the slash commands to directly, so changes show up instantly.
# Leave unset for a public bot: commands are registered globally (they can take up to an hour to appear).
# (Developer Mode -> right-click the server icon -> Copy Server ID)
# GUILD_IDS=111111111111111111,222222222222222222
# Optional: where each server's filters are kept. Defaults to procbot.db next to bot.py.
# DB_PATH=/path/to/procbot.db
# Optional: the time zone for /onthisday's "today" and the daily post's time. Defaults to Europe/London.
# BOT_TIMEZONE=Europe/Dublin
# Optional: rolling log file. Defaults to logs/procbot.log (logs/procbot-dev.log with --dev).
# LOG_FILE=logs/procbot.log
